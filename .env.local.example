# Local infrastructure (docker-compose.yml)
POSTGRES_DB=aquify
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=aquify-local

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Local app wiring
APP_ENV=development
AUTH_ENABLE_DEV_STUB_TOKENS=true
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
OIDC_REDIRECT_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_EXPECTED_ISSUER=
OIDC_STATE_SIGNING_KEY=change-me
OIDC_HTTP_TIMEOUT=10s
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=aquify
# If using local Postgres.app/Homebrew with your macOS user instead of postgres:
# DATABASE_URL=postgres://<your-macos-user>@localhost:5432/aquify?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aquify?sslmode=disable
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
SMTP_HOST=localhost
SMTP_PORT=1025
