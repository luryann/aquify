# Shared
APP_ENV=development
AUTH_ENABLE_DEV_STUB_TOKENS=true

# API
API_ADDR=:8080
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
OIDC_REDIRECT_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_EXPECTED_ISSUER=
# Used to verify signed OIDC state payloads.
OIDC_STATE_SIGNING_KEY=change-me
OIDC_HTTP_TIMEOUT=10s
# If local auth uses your macOS user (common with Postgres.app), replace user/password accordingly.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aquify?sslmode=disable
REDIS_URL=redis://localhost:6379/0
STORAGE_ENDPOINT=localhost:9000
STORAGE_BUCKET=aquify
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
# Required in staging/production; local/test may use provider stubs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_RECONCILIATION_ALERT_THRESHOLD_CENTS=100
# Required in staging/production; local/test may use provider stubs.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_NAME=
POSTMARK_FROM_EMAIL=
POSTMARK_WEBHOOK_AUTH_HEADER_NAME=
POSTMARK_WEBHOOK_AUTH_HEADER_VALUE=
POSTMARK_WEBHOOK_BASIC_USER=
POSTMARK_WEBHOOK_BASIC_PASS=

# Admin
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_AUTH_ENABLE_DEV_STUB_TOKENS=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
