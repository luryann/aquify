# Shared
APP_ENV=development
AUTH_ENABLE_DEV_STUB_TOKENS=true

# API
API_ADDR=:8080
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
OIDC_REDIRECT_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_EXPECTED_ISSUER=
# Used to verify signed OIDC state payloads.
OIDC_STATE_SIGNING_KEY=change-me
OIDC_HTTP_TIMEOUT=10s
# If local auth uses your macOS user (common with Postgres.app), replace user/password accordingly.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aquify?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Admin
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
