# Shared
APP_ENV=development
AUTH_ENABLE_DEV_STUB_TOKENS=true

# API
API_ADDR=:8080
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
OIDC_END_SESSION_URL=
OIDC_REDIRECT_URL=
OIDC_POST_LOGOUT_REDIRECT_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_EXPECTED_ISSUER=
# Used to verify signed OIDC state payloads.
OIDC_STATE_SIGNING_KEY=change-me
OIDC_HTTP_TIMEOUT=10s
# If local auth uses your macOS user (common with Postgres.app), replace user/password accordingly.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aquify?sslmode=disable
REDIS_URL=redis://localhost:6379/0
STORAGE_ENDPOINT=localhost:9000
STORAGE_BUCKET=aquify
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
# Required in staging/production; local/test may use provider stubs.
# Required in staging/production: encrypts stored third-party credentials (USA Swimming client secret).
INTEGRATIONS_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret of the Connect webhook endpoint (events on connected accounts).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Each club uses its own Stripe account. Unset = required outside development;
# set false only for a single-club deployment that still uses the platform account.
STRIPE_CONNECT_REQUIRED=
STRIPE_CURRENCY=usd
STRIPE_RECONCILIATION_ALERT_THRESHOLD_CENTS=100
# Required in staging/production; local/test may use provider stubs.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_NAME=
POSTMARK_FROM_EMAIL=
POSTMARK_WEBHOOK_AUTH_HEADER_NAME=
POSTMARK_WEBHOOK_AUTH_HEADER_VALUE=
POSTMARK_WEBHOOK_BASIC_USER=
POSTMARK_WEBHOOK_BASIC_PASS=

# Admin
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_AUTH_ENABLE_DEV_STUB_TOKENS=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Multi-tenancy
# UUID of the dedicated platform org. Setting it mounts the operator plane
# (/api/v1/platform/*); operators are Keycloak users in that org with the
# platform_admin realm role. Unset = the operator plane does not exist.
PLATFORM_ORG_ID=
# How long a closing club waits before its data can be permanently deleted.
PLATFORM_OFFBOARDING_COOLING_OFF=336h
# Authenticated API requests per organization per window (0 disables).
SECURITY_RATE_LIMIT_ORG_REQUESTS=6000
SECURITY_RATE_LIMIT_ORG_WINDOW=1m
# Per-org limits: emails per rolling 24h (0 = unlimited) and document storage bytes per org.
COMMS_ORG_DAILY_EMAIL_CAP=20000
ORG_DOCUMENT_STORAGE_BYTES=10737418240
# Optional operator override of which orgs receive scheduled jobs; empty = every active org.
WORKER_SCHEDULED_ORG_IDS=
# In-memory club cache bounds: evict a club idle this long, and keep at most this many clubs per process.
CACHE_ORG_IDLE_TTL=30m
CACHE_MAX_ORGS=200
