[Unit]
Description=aquify Platform (Docker Compose)
Documentation=https://github.com/luryann/aquify
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=aquify
Group=aquify
WorkingDirectory=/opt/aquify

# Compose reads ${VARS} for docker-compose.production.yml from these two files
# (service env_file entries do NOT feed interpolation):
#   .env.production  infrastructure secrets (root:aquify 640, never written by scripts)
#   release.env      IMAGE_TAG / GHCR_NAMESPACE, rewritten by promote.sh and rollback.sh
# There is deliberately no `pull` here: a restart must come back on the exact
# images that were last promoted, not on whatever a tag points at today. Images are
# pulled by promote.sh.

# Start all services, removing any orphaned containers
ExecStart=/usr/bin/docker compose --project-directory /opt/aquify --env-file /opt/aquify/.env.production --env-file /opt/aquify/release.env -f /opt/aquify/docker-compose.production.yml up --remove-orphans

# Graceful shutdown: stop all containers
ExecStop=/usr/bin/docker compose --project-directory /opt/aquify --env-file /opt/aquify/.env.production --env-file /opt/aquify/release.env -f /opt/aquify/docker-compose.production.yml down

# Reload: recreate the application services only (use promote.sh for releases)
ExecReload=/usr/bin/docker compose --project-directory /opt/aquify --env-file /opt/aquify/.env.production --env-file /opt/aquify/release.env -f /opt/aquify/docker-compose.production.yml up -d --no-deps --remove-orphans aquify-api aquify-admin aquify-worker

Restart=on-failure
RestartSec=10s
# First start after a fresh install may need to pull/extract several images.
TimeoutStartSec=600s
TimeoutStopSec=120s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aquify-platform

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/aquify /var/log/aquify
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
