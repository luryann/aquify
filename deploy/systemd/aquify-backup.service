[Unit]
Description=aquify Platform Backup
Documentation=https://github.com/luryann/aquify
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=aquify
Group=aquify
WorkingDirectory=/opt/aquify

ExecStart=/opt/aquify/scripts/backup.sh

# Allow sufficient time for a full backup + upload
TimeoutStartSec=3600s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aquify-backup

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/aquify /var/backups/aquify /var/log/aquify
ProtectHome=read-only

# No EnvironmentFile: backup.sh parses /opt/aquify/.env.production and .env.backup itself
# (they are never sourced). The aquify user needs access to the docker socket.

[Install]
WantedBy=multi-user.target
