[Unit]
Description=DARE Platform Backup
Documentation=https://github.com/dareaquatics/aquify
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=dare
Group=dare
WorkingDirectory=/opt/dare

ExecStart=/opt/dare/scripts/backup.sh

# Allow sufficient time for a full backup + upload
TimeoutStartSec=3600s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dare-backup

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/dare /var/backups/dare /var/log/dare
ProtectHome=read-only

EnvironmentFile=-/opt/dare/.env.production

[Install]
WantedBy=multi-user.target
