# Aquify production — INFRASTRUCTURE secrets and compose interpolation values.
# Install as /opt/aquify/.env.production   (owner root:aquify, mode 640).
#
# Used by `docker compose --env-file` to fill ${VARS} in docker-compose.production.yml
# and by the host backup/restore scripts. It is NOT handed to the API or worker
# containers (those read .env.app); the Postgres superuser password and the
# schema-owner password therefore never reach the long-running application.
#
# Every CHANGE_ME value must be replaced; deploy/scripts/preflight.sh refuses to
# pass while any remain. Generate secrets with:  openssl rand -hex 24
# Passwords are restricted to [A-Za-z0-9_-] and 16+ characters (they appear in
# postgres:// URLs and connection settings, so nothing needing escaping is allowed).

# --- Public hostnames and TLS ------------------------------------------------
# The ingress serves app.<domain>, api.<domain>, auth.<domain> and files.<domain>;
# all four must resolve to this server before first start (ports 80/443 open).
# For a disposable rehearsal VM with no DNS, a wildcard name such as
# 203-0-113-10.sslip.io works as the domain.
AQUIFY_DOMAIN=CHANGE_ME
# Contact address for the certificate authority (expiry / problem notices).
ACME_EMAIL=CHANGE_ME

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=aquify
# Bootstrap superuser: init script and break-glass maintenance only.
POSTGRES_USER=aquify_admin
POSTGRES_PASSWORD=CHANGE_ME
# Owns the schema; used only by `aquify-api migrate up` (aquify-migrate service).
AQUIFY_OWNER_DB_USER=aquify_owner
AQUIFY_OWNER_DB_PASSWORD=CHANGE_ME
# What the API and worker connect as (DATABASE_URL in .env.app). NOSUPERUSER, NOBYPASSRLS.
AQUIFY_APP_DB_USER=aquify_app
AQUIFY_APP_DB_PASSWORD=CHANGE_ME
# Read-only role for pg_dump (BYPASSRLS so every club is included).
AQUIFY_BACKUP_DB_USER=aquify_backup
AQUIFY_BACKUP_DB_PASSWORD=CHANGE_ME
# Keycloak's own database and role.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# --- Redis (Asynq job broker) ------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- MinIO (object storage) --------------------------------------------------
# Root credentials: administration only. The application uses a scoped service
# account (STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY in .env.app), never these.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- Keycloak bootstrap admin ------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
