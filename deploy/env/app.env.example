# Aquify production — API and WORKER runtime configuration.
# Install as /opt/aquify/.env.app   (owner root:aquify, mode 640).
# Loaded by docker-compose.production.yml (`env_file`) for aquify-api and aquify-worker only.
# APP_ENV, API_ADDR and the AUTH_* dev switches are pinned in the compose file.
#
# Replace every CHANGE_ME / example.com value; deploy/scripts/preflight.sh checks them.
# Generate secrets with:  openssl rand -hex 32

# --- Database (restricted application role; see .env.production) -------------
# User/password must equal AQUIFY_APP_DB_USER / AQUIFY_APP_DB_PASSWORD. Startup
# refuses a superuser or BYPASSRLS role.
DATABASE_URL=postgres://aquify_app:CHANGE_ME@postgres:5432/aquify?sslmode=disable

# --- Redis -------------------------------------------------------------------
# Password must equal REDIS_PASSWORD in .env.production.
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# --- Origins and proxy -------------------------------------------------------
# Comma-separated bare https origins of the admin web app (CORS, Stripe return URLs).
API_ALLOWED_ORIGINS=https://app.example.com
# Networks allowed to set X-Forwarded-For (the ingress proxy's docker network).
# Without this every visitor shares the proxy's address and the per-IP limits
# (auth 20/min, stripe 10/min) apply to the whole site.
SECURITY_TRUSTED_PROXY_CIDRS=172.21.0.0/24
# Dedicated metrics listener, reachable by Prometheus on the internal network only.
METRICS_ADDR=:9091

# --- Object storage (scoped MinIO service account, NOT the root user) ---------
# Must be a hostname browsers can reach: presigned upload/download URLs are signed
# for exactly this host.
STORAGE_ENDPOINT=files.example.com
STORAGE_USE_SSL=true
STORAGE_BUCKET=aquify
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME

# --- Encryption of stored third-party credentials ------------------------------
INTEGRATIONS_ENCRYPTION_KEY=CHANGE_ME

# --- OIDC (Keycloak) -----------------------------------------------------------
OIDC_AUTHORIZE_URL=https://auth.example.com/realms/aquify/protocol/openid-connect/auth
OIDC_TOKEN_URL=https://auth.example.com/realms/aquify/protocol/openid-connect/token
OIDC_JWKS_URL=https://auth.example.com/realms/aquify/protocol/openid-connect/certs
OIDC_END_SESSION_URL=https://auth.example.com/realms/aquify/protocol/openid-connect/logout
OIDC_REDIRECT_URL=https://app.example.com/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URL=https://app.example.com/login
OIDC_EXPECTED_ISSUER=https://auth.example.com/realms/aquify
OIDC_CLIENT_ID=aquify-id
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_STATE_SIGNING_KEY=CHANGE_ME

# --- Keycloak Admin API (service account, for user management) ------------------
KEYCLOAK_ADMIN_URL=http://keycloak:8081
KEYCLOAK_REALM=aquify
KEYCLOAK_ADMIN_CLIENT_ID=aquify-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME

# --- Stripe ---------------------------------------------------------------------
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
STRIPE_CONNECT_WEBHOOK_SECRET=CHANGE_ME
STRIPE_CURRENCY=usd

# --- Postmark -------------------------------------------------------------------
POSTMARK_SERVER_TOKEN=CHANGE_ME
POSTMARK_FROM_NAME=Aquify
POSTMARK_FROM_EMAIL=noreply@example.com
# Postmark webhook auth: a shared-secret header, or HTTP basic auth.
POSTMARK_WEBHOOK_AUTH_HEADER_NAME=X-Postmark-Webhook
POSTMARK_WEBHOOK_AUTH_HEADER_VALUE=CHANGE_ME

# --- Optional -------------------------------------------------------------------
# Optional operator plane (/api/v1/platform/*); unset = the plane does not exist.
# PLATFORM_ORG_ID=
# Optional override of which orgs receive scheduled jobs; empty = every active org.
# WORKER_SCHEDULED_ORG_IDS=
# OTEL_EXPORTER_OTLP_ENDPOINT=
