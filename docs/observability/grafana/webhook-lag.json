{
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "DARE Platform — Stripe webhook receipt-to-processing latency.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Webhook Processing Lag p50/p95/p99 (s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, event_type) (rate(dare_webhook_processing_lag_seconds_bucket[5m])))",
          "legendFormat": "p50 {{event_type}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, event_type) (rate(dare_webhook_processing_lag_seconds_bucket[5m])))",
          "legendFormat": "p95 {{event_type}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, event_type) (rate(dare_webhook_processing_lag_seconds_bucket[5m])))",
          "legendFormat": "p99 {{event_type}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Webhook Events Received (rate/5m by type)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (event_type) (rate(dare_webhook_processing_lag_seconds_count[5m]))",
          "legendFormat": "{{event_type}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 30 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto" },
      "title": "Current p95 Lag (all event types)",
      "type": "gauge",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dare_webhook_processing_lag_seconds_bucket[5m])))"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["dare", "webhooks", "stripe"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "DARE – Webhook Processing Lag",
  "uid": "dare-webhook-lag",
  "version": 1
}
